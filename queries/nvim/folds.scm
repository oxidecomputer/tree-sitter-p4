; folds.scm
;
; Folds for Neovim: declarations, tables and their properties, blocks, and the
; cases of a select or switch.

[
  (action)
  (block)
  (comment)
  (control_definition)
  (error_declaration)
  (extern_definition)
  (function_declaration)
  (header_definition)
  (header_union_definition)
  (match_kind_declaration)
  (obj_initializer)
  (parser_definition)
  (select_expr)
  (state)
  (struct_definition)
  (switch_statement)
  (table)
  (table_element)
] @fold

; folds.scm
;
; Folds for Neovim: declarations, tables and their properties, blocks, and the
; cases of a select or switch.

[
  (action)
  (block)
  (comment)
  (control_declaration)
  (error_declaration)
  (extern_declaration)
  (function_declaration)
  (header_declaration)
  (header_union_declaration)
  (match_kind_declaration)
  (object_initializer)
  (parser_declaration)
  (parser_state)
  (select_expression)
  (struct_declaration)
  (switch_statement)
  (table)
  (table_property)
] @fold
